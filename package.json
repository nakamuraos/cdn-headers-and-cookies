{
  "name": "cdn-headers-and-cookies",
  "version": "3.0.1",
  "description": "Inspect request headers, response headers, CDN debug headers and cookies for any request on the page",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev:chrome": "cross-env TARGET_BROWSER=chrome vite build --config vite.config.ts --mode development --watch",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox vite build --config vite.config.ts --mode development --watch",
    "build:chrome": "cross-env TARGET_BROWSER=chrome vite build --config vite.config.ts && yarn clean:metadata",
    "build:firefox": "cross-env TARGET_BROWSER=firefox vite build --config vite.config.ts && yarn clean:metadata",
    "clean:metadata": "node scripts/clean-macos-metadata.mjs",
    "build": "yarn build:chrome && yarn build:firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.4",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "prettier-config-standard": "^7.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-clean": "^2.0.1",
    "vite-plugin-wext-manifest": "^1.2.2",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.0.18"
  }
}
